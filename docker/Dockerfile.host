# Native-architecture host tools; arm64 package builds remain in builder_exec.
# The physical host needs Docker and registered arm64 binfmt, not build packages.
ARG DOCKER_CLI_IMAGE=docker:29.8.0-cli
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates git curl rsync zstd xz-utils tar \
      parted dosfstools e2fsprogs squashfs-tools kmod util-linux \
      build-essential bc bison flex libssl-dev libelf-dev swig \
      gcc-aarch64-linux-gnu binutils-aarch64-linux-gnu libc6-dev-arm64-cross libgnutls28-dev \
      python3 python3-dev python3-setuptools python3-pyelftools python3-pycryptodome \
      xorriso debhelper dpkg-dev fakeroot \
      sudo gpg gnupg2 gpg-agent dirmngr binutils cpio shellcheck file patch unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

CMD ["bash"]
